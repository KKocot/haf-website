---
import { externalLinks } from "../../config/links";
---

<footer class="tmux-status" role="contentinfo">
  <div class="tmux-status__bar">
    <a
      href={externalLinks.gitlab}
      class="tmux-status__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="HAF repository on GitLab — opens in new tab"
    >[haf]</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href={externalLinks.docs}
      class="tmux-status__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Documentation — opens in new tab"
    >Documentation</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href={externalLinks.hive}
      class="tmux-status__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hive — opens in new tab"
    >Hive</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href={externalLinks.hiveTools}
      class="tmux-status__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hive Tools — opens in new tab"
    >Hive Tools</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href={externalLinks.blockchainWares}
      class="tmux-status__link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Blockchain Wares — opens in new tab"
    >Blockchain Wares</a>
  </div>
</footer>

<style>
  .tmux-status {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .tmux-status__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    min-height: 2rem;
  }

  .tmux-status__segment {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .tmux-status__sep {
    color: var(--color-text-subtle);
    padding-inline: var(--space-2);
    user-select: none;
  }

  .tmux-status__link {
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .tmux-status__link:hover,
  .tmux-status__link:focus-visible {
    color: var(--color-primary-bright);
  }

  .tmux-status__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 40rem) {
    .tmux-status__bar {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
