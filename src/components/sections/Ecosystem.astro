---
import SectionHeading from "../ui/SectionHeading.astro";

const projects = [
  {
    name: "Hivemind",
    description:
      "Social networking layer for Hive. Indexes posts, comments, votes, and follows for community applications.",
    repo: "https://gitlab.syncad.com/hive/hivemind",
  },
  {
    name: "HAF API Node",
    description:
      "Complete deployment solution for HAF with Docker Compose. Includes pgAdmin, pgHero, and monitoring.",
    repo: "https://gitlab.syncad.com/hive/haf_api_node",
  },
  {
    name: "HAfAH",
    description:
      "REST API serving account history, transaction lookups, and block data from HAF’s PostgreSQL tables.",
    repo: "https://gitlab.syncad.com/hive/HAfAH",
    website: "https://hafah-website.vercel.app",
  },
  {
    name: "Balance Tracker",
    description:
      "Real-time HIVE and HBD balance tracking with historical data. Tracks all transfer operations.",
    repo: "https://gitlab.syncad.com/hive/balance_tracker",
    website: "https://balance-tracker-landing.vercel.app",
  },
  {
    name: "Reputation Tracker",
    description:
      "Tracks Hive account reputation scores by indexing vote operations and computing live reputation values.",
    repo: "https://gitlab.syncad.com/hive/reputation_tracker",
  },
  {
    name: "HAfBE",
    description:
      "Backend engine powering the Block Explorer. Serves blocks, transactions, and operations via API from HAF tables.",
    repo: "https://gitlab.syncad.com/hive/haf_block_explorer",
    website: "https://hafbe-website.vercel.app",
  },
];
---

<section id="ecosystem" class="section-padding ecosystem-section section-divider" aria-labelledby="ecosystem-heading">
  <div class="container">
    <div class="eco-heading-wrap">
      <SectionHeading
        id="ecosystem-heading"
        title="What awaits across the bridge"
        subtitle="These apps run on HAF in production, serving the Hive network daily."
        data-scroll-reveal
      />
    </div>

    <div class="eco-grid">
      {
        projects.map((project, index) => (
          <article class="eco-item" data-scroll-reveal style={`--i: ${index}`}>
            <h3 class="eco-item__name">{project.name}</h3>
            <p class="eco-item__desc">{project.description}</p>
            <div class="eco-item__links">
              <a
                href={project.repo}
                class="eco-item__link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Repository&thinsp;&rarr;
              </a>
              {project.website && (
                <a
                  href={project.website}
                  class="eco-item__link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Website&thinsp;&rarr;
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ecosystem-section {
    position: relative;
    background: var(--color-bg);
  }

  /* ----------------------------------------------------------------
     Grid — 1 col mobile, 2 col desktop
     ---------------------------------------------------------------- */

  .eco-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .eco-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ----------------------------------------------------------------
     Item
     ---------------------------------------------------------------- */

  .eco-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-8) 0;
    border-top: 1px solid rgba(255, 98, 7, 0.1);
    transition: border-color 0.3s ease;
  }

  .eco-item:hover {
    border-top-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .eco-item {
      padding: var(--space-10) var(--space-8) var(--space-10) 0;
    }

    /* Right column items get left padding for visual separation */
    .eco-item:nth-child(even) {
      padding-left: var(--space-8);
      padding-right: 0;
    }

    /* Vertical separator between columns via border on even items */
    .eco-item:nth-child(even) {
      border-left: 1px solid rgba(255, 98, 7, 0.1);
    }
  }

  /* Stagger reveal */
  .eco-item:global([data-scroll-reveal]) {
    animation-delay: calc(var(--i, 0) * 100ms);
  }

  /* ----------------------------------------------------------------
     Content
     ---------------------------------------------------------------- */

.eco-item__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text-bright);
  }

  .eco-item__desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  /* ----------------------------------------------------------------
     Link — dashed underline editorial style
     ---------------------------------------------------------------- */

  .eco-item__links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .eco-item__link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-primary);
    padding-bottom: 1px;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .eco-item__link:hover {
    color: var(--color-primary-bright);
    border-bottom-style: solid;
    border-bottom-color: var(--color-primary-bright);
  }

  /* ----------------------------------------------------------------
     Reduced motion
     ---------------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .eco-item:global([data-scroll-reveal]) {
      animation-delay: 0ms !important;
    }

    .eco-item {
      transition: none !important;
    }
  }
</style>
