---
import { navLinks, externalLinks } from "../../config/links";
import MobileMenu from "../islands/MobileMenu";
---

<header class="haf-nav" id="main-nav" role="banner">
  <nav class="container haf-nav__inner" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="haf-nav__logo" aria-label="HAF - Hive Application Framework, go to homepage">
      <span class="haf-nav__logo-mark">HAF</span>
      <span class="haf-nav__logo-sub" aria-hidden="true">Hive Application Framework</span>
    </a>

    <!-- Desktop links (absolute centered) -->
    <ul class="haf-nav__links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="haf-nav__link">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA -->
    <div class="haf-nav__actions">
      <a
        href={externalLinks.gitlab}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="HAF on GitLab"
        class="haf-nav__gitlab"
      >
        <svg width="24" height="24" viewBox="0 0 380 380" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M190 353.2L253.3 158.8H126.7L190 353.2Z" fill="#E24329"/>
          <path d="M190 353.2L126.7 158.8H24.7L190 353.2Z" fill="#FC6D26"/>
          <path d="M24.7 158.8L5.1 219.1C3.3 224.7 5.2 230.8 10 234.3L190 353.2L24.7 158.8Z" fill="#FCA326"/>
          <path d="M24.7 158.8H126.7L83.4 25.7C81.4 19.8 73 19.8 71 25.7L24.7 158.8Z" fill="#E24329"/>
          <path d="M190 353.2L253.3 158.8H355.3L190 353.2Z" fill="#FC6D26"/>
          <path d="M355.3 158.8L374.9 219.1C376.7 224.7 374.8 230.8 370 234.3L190 353.2L355.3 158.8Z" fill="#FCA326"/>
          <path d="M355.3 158.8H253.3L296.6 25.7C298.6 19.8 307 19.8 309 25.7L355.3 158.8Z" fill="#E24329"/>
        </svg>
      </a>
    </div>

    <!-- Mobile hamburger -->
    <MobileMenu links={navLinks} gitlabUrl={externalLinks.gitlab} client:media="(max-width: 1023px)" />
  </nav>
</header>

<script>
  // IntersectionObserver: toggle scrolled state when hero leaves viewport
  const nav = document.getElementById('main-nav');
  const hero = document.getElementById('hero');

  if (nav && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          nav.removeAttribute('data-scrolled');
        } else {
          nav.setAttribute('data-scrolled', '');
        }
      },
      { threshold: 0, rootMargin: '-64px 0px 0px 0px' }
    );
    observer.observe(hero);
  }

  // IntersectionObserver: active section highlighting in navbar
  const sectionIds = ['features', 'architecture', 'ecosystem', 'getting-started'];
  const navLinks = nav?.querySelectorAll<HTMLAnchorElement>('.haf-nav__link');
  const ACTIVE_CLASS = 'haf-nav__link--active';

  function setActiveLink(href: string | null) {
    navLinks?.forEach((link) => {
      link.classList.remove(ACTIVE_CLASS);
      link.removeAttribute('aria-current');
    });

    if (href) {
      const activeLink = nav?.querySelector<HTMLAnchorElement>(`.haf-nav__link[href="${href}"]`);
      if (activeLink) {
        activeLink.classList.add(ACTIVE_CLASS);
        activeLink.setAttribute('aria-current', 'true');
      }
    }

    window.dispatchEvent(new CustomEvent('section-change', { detail: { href } }));
  }

  if (nav && navLinks?.length) {
    const activeSections = new Set<string>();

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            activeSections.add(id);
          } else {
            activeSections.delete(id);
          }
        });

        // Pick the first visible section in DOM order
        const currentId = sectionIds.find((id) => activeSections.has(id));
        setActiveLink(currentId ? `#${currentId}` : null);
      },
      { threshold: 0.3, rootMargin: '-64px 0px 0px 0px' }
    );

    sectionIds.forEach((id) => {
      const section = document.getElementById(id);
      if (section) sectionObserver.observe(section);
    });
  }
</script>

<style>
  .haf-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-toast); /* z-50 */
    background-color: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.3s ease-out,
      backdrop-filter 0.3s ease-out;
  }

  /* Scrolled state — dark frosted glass */
  .haf-nav:global([data-scrolled]) {
    background-color: rgba(15, 15, 15, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .haf-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem; /* 64px */
    position: relative;
  }

  /* --- Logo --- */

  .haf-nav__logo {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
    z-index: 1;
  }

  .haf-nav__logo:hover {
    color: inherit;
  }

  .haf-nav__logo-mark {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    letter-spacing: var(--tracking-tight);
  }

  .haf-nav__logo-sub {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-normal);
    display: none;
    transition: color 0.3s ease-out;
  }

  @media (min-width: 768px) {
    .haf-nav__logo-sub {
      display: inline;
    }
  }

  /* --- Desktop nav links (absolute centered) --- */

  .haf-nav__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-1);
  }

  @media (min-width: 1024px) {
    .haf-nav__links {
      display: flex;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .haf-nav__link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color 0.3s ease-out,
      background-color var(--transition-fast);
  }

  .haf-nav__link:hover {
    color: var(--color-text);
    background-color: var(--color-primary-ghost);
  }

  .haf-nav__link:global(.haf-nav__link--active) {
    color: var(--color-primary);
    background-color: var(--color-primary-ghost);
    box-shadow: inset 0 -2px 0 var(--color-primary);
  }

  .haf-nav__link:global(.haf-nav__link--active):hover {
    color: var(--color-primary-bright);
  }

  /* --- Desktop actions --- */

  .haf-nav__actions {
    display: none;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .haf-nav__actions {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
  }

  .haf-nav__gitlab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition:
      color var(--transition-fast),
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .haf-nav__gitlab:hover {
    color: var(--color-primary);
    transform: scale(1.1);
    filter: drop-shadow(0 0 6px rgba(252, 109, 38, 0.5));
  }

  .haf-nav__gitlab svg {
    display: block;
  }
</style>
