---
import SectionHeading from "../ui/SectionHeading.astro";

const features = [
  {
    title: "Push Model",
    subtitle: "Data flows to you",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    description:
      "Data flows directly from hived to PostgreSQL via sql_serializer plugin. No polling, no rate limits, no missed blocks.",
  },
  {
    title: "Automatic Fork Handling",
    subtitle: "The bridge holds during storms",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
    description:
      "HiveForkManager automatically rolls back application data during microforks. Your app stays consistent without any extra code.",
  },
  {
    title: "Multi-App Architecture",
    subtitle: "One bridge, many travelers",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="6" height="6" rx="1"/><rect x="16" y="2" width="6" height="6" rx="1"/><rect x="9" y="14" width="6" height="6" rx="1"/><path d="M5 8v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><path d="M12 12v2"/></svg>`,
    description:
      "Run multiple applications on a single HAF server. Each app gets its own context while sharing the same blockchain data.",
  },
  {
    title: "SQL Interface",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    description:
      "Access blocks, transactions, and operations through standard PostgreSQL queries. Use any language or tool that speaks SQL.",
  },
  {
    title: "Docker Deployment",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12.5c0-.28-.22-.5-.5-.5h-2.08c-.09-.7-.27-1.37-.54-2h1.12c.28 0 .5-.22.5-.5s-.22-.5-.5-.5H18.6a7 7 0 0 0-1.74-2.26l1.28-1.28a.5.5 0 0 0-.7-.7L16.14 6A7 7 0 0 0 12 4.5 7 7 0 0 0 5 11.5c0 3.87 3.13 7 7 7s7-3.13 7-7h2.5c.28 0 .5-.22.5-.5z"/><rect x="7" y="8" width="2" height="2" rx="0.5"/><rect x="11" y="8" width="2" height="2" rx="0.5"/><rect x="15" y="8" width="2" height="2" rx="0.5"/><rect x="7" y="12" width="2" height="2" rx="0.5"/><rect x="11" y="12" width="2" height="2" rx="0.5"/></svg>`,
    description:
      "Production-ready Docker Compose setup with pgAdmin and pgHero. Clone, configure, and start syncing in under 5 minutes.",
  },
  {
    title: "Staged Sync",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    description:
      "Three sync modes — massive replay, P2P sync, and live sync — with indexes dropped during replay and rebuilt after.",
  },
];
---

<section id="features" class="section-padding features-section section-divider" aria-labelledby="features-heading">
  <div class="container">
    <SectionHeading
      id="features-heading"
      badge="Three Pillars of the Bridge"
      title="Blockchain data, SQL access, fork safety"
      subtitle="HAF syncs blocks to PostgreSQL, manages forks, and isolates app contexts — you write SQL."
      data-scroll-reveal
    />

    <div class="features-grid">
      {
        features.map((feature, index) => (
          <article
            class="feature-item"
            data-scroll-reveal
            style={`--i: ${index}`}
          >
            <div class="feature-item__icon" aria-hidden="true">
              {/* SAFETY: icon is a static SVG string defined above, not user input */}
              <Fragment set:html={feature.icon} />
            </div>
            <div class="feature-item__content">
              <h3 class="feature-item__title">{feature.title}</h3>
              {feature.subtitle && (
                <span class="feature-item__subtitle">{feature.subtitle}</span>
              )}
              <p class="feature-item__description">{feature.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-section {
    position: relative;
  }

  /* ==========================================================================
     Features Grid — responsive 1 → 2 → 3 columns
     ========================================================================== */

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-8);
    row-gap: 0;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ==========================================================================
     Feature Item
     ========================================================================== */

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  /* --------------------------------------------------------------------------
     Row dividers — horizontal lines between rows, NOT between columns
     Mobile (1 col): every item except the last gets a bottom border
     -------------------------------------------------------------------------- */

  .feature-item {
    border-bottom: 1px solid rgba(255, 98, 7, 0.1);
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  /* Tablet (2 col): last row = items 5-6 → no border */
  @media (min-width: 768px) {
    /* Remove border from the last row (last 2 items in 2-col layout with 6 items) */
    .feature-item:nth-last-child(-n + 2) {
      border-bottom: none;
    }

    /* Edge case: if last row has only 1 item, nth-last-child(1) already matches.
       For 6 items in 2-col, last row is items 5-6 — both get no border. */
  }

  /* Desktop (3 col): last row = items 4-6 → no border */
  @media (min-width: 1024px) {
    /* Reset tablet rule */
    .feature-item:nth-last-child(-n + 2) {
      border-bottom: 1px solid rgba(255, 98, 7, 0.1);
    }

    /* Remove border from last row (last 3 items in 3-col layout with 6 items) */
    .feature-item:nth-last-child(-n + 3) {
      border-bottom: none;
    }
  }

  /* --- Icon --- */

  .feature-item__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-primary);
    margin-block-start: var(--space-1);
  }

  .feature-item__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* --- Content --- */

  .feature-item__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .feature-item__title {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-snug);
    color: var(--color-text-bright);
    margin: 0;
  }

  .feature-item__subtitle {
    font-size: var(--text-sm);
    color: var(--color-primary-bright);
    line-height: var(--leading-snug);
  }

  .feature-item__description {
    margin: 0;
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* ==========================================================================
     Scroll-reveal animations — stagger via --i
     ========================================================================== */

  .feature-item[data-scroll-reveal] {
    animation: scroll-reveal-up 600ms ease both;
    animation-delay: calc(var(--i, 0) * 120ms);
    animation-timeline: view();
    animation-range: entry 0% entry 60%;
  }

  .feature-item.scroll-reveal-visible {
    animation: scroll-reveal-up 600ms ease both;
    animation-delay: calc(var(--i, 0) * 120ms);
  }

  /* ==========================================================================
     Reduced motion
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .feature-item[data-scroll-reveal],
    .feature-item.scroll-reveal-visible {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
