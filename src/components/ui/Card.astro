---
interface Props {
  glow?: boolean;
  class?: string;
}

const { glow = false, class: className } = Astro.props;
---

<article
  class:list={["haf-card", { "haf-card--glow": glow }, className]}
>
  <slot />
</article>

<style>
  .haf-card {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .haf-card:hover {
    border-color: var(--color-border-card-hover);
    box-shadow: inset 0 1px 0 rgba(255, 98, 7, 0.15);
  }

  /* --- Glow variant --- */

  .haf-card--glow {
    box-shadow: inset 0 1px 0 rgba(255, 98, 7, 0.08);
  }

  .haf-card--glow:hover {
    box-shadow: inset 0 1px 0 rgba(255, 98, 7, 0.2);
  }
</style>
