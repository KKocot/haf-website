---
interface Props {
  class?: string;
  "data-scroll-reveal"?: boolean;
  style?: string;
}

const { class: className, style, ...attrs } = Astro.props;
---

<article class:list={["haf-card", className]} style={style} {...attrs}>
  <slot />
</article>

<style>
  .haf-card {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .haf-card:hover {
    border-color: var(--color-border-card-hover);
    box-shadow: inset 0 1px 0 rgba(255, 98, 7, 0.15);
  }
</style>
