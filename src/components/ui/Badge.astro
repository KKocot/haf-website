---
interface Props {
  variant?: "accent" | "hero";
  class?: string;
}

const { variant = "accent", class: className } = Astro.props;

const variantClasses: Record<string, string> = {
  accent: "haf-badge--accent",
  hero: "haf-badge--hero",
};
---

<span class:list={["haf-badge", variantClasses[variant], className]}>
  <slot />
</span>

<style>
  .haf-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.25rem 0.625rem; /* 4px 10px */
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* --- Accent (primary tint) --- */

  .haf-badge--accent {
    background-color: var(--color-primary-ghost);
    border-color: rgba(255, 98, 7, 0.2);
    color: var(--color-primary-bright);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  /* --- Hero (dark pill on light bg) --- */

  .haf-badge--hero {
    background-color: var(--color-hero-badge-bg);
    border-color: var(--color-hero-badge-bg);
    color: var(--color-hero-badge-text);
  }
</style>
