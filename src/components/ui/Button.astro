---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "gradient";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  "aria-label"?: string;
  "aria-expanded"?: boolean;
  "aria-controls"?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

const sizeClasses: Record<string, string> = {
  sm: "haf-btn--sm",
  md: "haf-btn--md",
  lg: "haf-btn--lg",
};

const variantClasses: Record<string, string> = {
  primary: "haf-btn--primary",
  secondary: "haf-btn--secondary",
  ghost: "haf-btn--ghost",
  gradient: "haf-btn--gradient gradient-btn",
};
---

<Tag
  class:list={["haf-btn", sizeClasses[size], variantClasses[variant], className]}
  {...href ? { href } : { type: "button" }}
  {...rest}
>
  <slot />
</Tag>

<style>
  .haf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform 75ms ease-in;
  }

  .haf-btn:active {
    transform: translateY(1px);
  }

  .haf-btn:focus-visible {
    box-shadow: var(--shadow-focus-ring);
  }

  /* --- Sizes --- */

  .haf-btn--sm {
    height: 2.25rem; /* 36px */
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
  }

  .haf-btn--md {
    height: 2.75rem; /* 44px */
    padding-inline: var(--space-6);
    font-size: var(--text-base);
  }

  .haf-btn--lg {
    height: 3.25rem; /* 52px */
    padding-inline: var(--space-8);
    font-size: var(--text-lg);
  }

  /* --- Primary --- */

  .haf-btn--primary {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    border-color: var(--color-primary);
  }

  .haf-btn--primary:hover {
    background-color: var(--color-primary-bright);
    border-color: var(--color-primary-bright);
    box-shadow: var(--shadow-glow-sm);
    color: var(--color-text-on-primary);
  }

  /* --- Secondary --- */

  .haf-btn--secondary {
    background-color: transparent;
    color: var(--color-text);
    border-color: var(--color-border-bright);
  }

  .haf-btn--secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-bright);
  }

  /* --- Ghost --- */

  .haf-btn--ghost {
    background-color: transparent;
    color: var(--color-primary);
    border-color: transparent;
  }

  .haf-btn--ghost:hover {
    background-color: var(--color-primary-ghost);
  }

  /* --- Gradient (orange CTA) --- */

  .haf-btn--gradient {
    background: var(--gradient-btn-orange);
    color: white;
    border-color: transparent;
  }

  .haf-btn--gradient:hover {
    opacity: 0.9;
    box-shadow: var(--shadow-glow-sm);
    color: white;
  }
</style>
