---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The page you are looking for does not exist.">
  <main
    id="main"
    class="min-h-screen flex flex-col items-center justify-center gap-[var(--space-6)] px-[var(--space-4)]"
  >
    <p
      class="text-[var(--text-7xl)] font-[var(--font-weight-extrabold)] leading-[var(--leading-tight)] gradient-text"
    >
      404
    </p>
    <h1
      class="text-[var(--text-2xl)] font-[var(--font-weight-semibold)] text-[var(--color-text)]"
    >
      Page Not Found
    </h1>
    <p
      class="text-[var(--color-text-muted)] text-center max-w-md leading-[var(--leading-normal)]"
    >
      The page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-[var(--space-2)] px-[var(--space-6)] py-[var(--space-3)] rounded-[var(--radius-md)] bg-[var(--color-primary)] text-[var(--color-text-on-primary)] text-[var(--text-sm)] font-[var(--font-weight-semibold)] hover:bg-[var(--color-primary-bright)] hover:shadow-[var(--shadow-glow-sm)] transition-all duration-150 ease-out active:translate-y-px"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      Back to Home
    </a>
  </main>
</BaseLayout>
